# Veri tabanı (PostgreSQL)
DATABASE_URL="postgresql://yarinlab:yarinlab@localhost:5432/yarinlab"
# Göçler için havuzsuz bağlantı (Neon/Vercel Postgres bunu otomatik tanımlar; yerelde aynı adres)
DATABASE_URL_UNPOOLED="postgresql://yarinlab:yarinlab@localhost:5432/yarinlab"
PORT=3001
# Üretimde HTTPS arkasında true olmalı (çerez yalnızca HTTPS ile gönderilir)
COOKIE_SECURE=false

# Yapay zekâ (isteğe bağlı). Ayarlanmazsa doğrulanmış çevrim dışı geri bildirim kullanılır.
# Anahtar YALNIZCA sunucu ortamında tutulur; istemci paketine veya repoya konmaz.
AI_PROVIDER=none            # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=6000
AI_DAILY_USER_CALLS=60      # kullanıcı başına günlük model çağrısı
AI_DAILY_TOKEN_BUDGET=2000000
